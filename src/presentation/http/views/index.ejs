<%- include('includes/head'); %>
<%- include('includes/nav'); %>

<main class="container" id="conteudo">
  <div class="row justify-content-center">
    <div class="col-lg-9 my-4">
      <%- include('includes/messages') %>

      <% if (!user) { %>
        <div class="app-card empty-state">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          <h1>Sua agenda de contatos</h1>
          <p class="lead">
            Organize seus contatos em um só lugar.
            <a href="/login/index">Entre ou crie sua conta</a> para começar.
          </p>
          <p class="mt-3">
            <a class="btn btn-primary" href="/cadastro">Criar conta gratuita</a>
            <a class="btn btn-outline-primary ml-2" href="/login/index">Entrar</a>
          </p>
        </div>
      <% } else if (contatos.length === 0 && !(filtros && filtros.ativos)) { %>
        <div class="app-card empty-state">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <h1>Sua agenda ainda está vazia.</h1>
          <p class="lead">Cadastre seu primeiro contato para vê-lo aqui.</p>
          <p class="mt-3"><a class="btn btn-primary" href="/contato/index">Cadastrar primeiro contato</a></p>
        </div>
      <% } else { %>
        <div class="app-card">
          <div class="page-head d-flex justify-content-between align-items-center flex-wrap">
            <div>
              <h1 class="mb-1">Agenda</h1>
              <p class="subtitle mb-0">
                <% if (filtros.ativos) { %>
                  <%= paginacao.total %> contato<%= paginacao.total === 1 ? '' : 's' %> encontrado<%= paginacao.total === 1 ? '' : 's' %>.
                <% } else { %>
                  <%= paginacao.total %> contato<%= paginacao.total === 1 ? '' : 's' %> na sua conta.
                <% } %>
              </p>
            </div>
            <div class="d-flex align-items-center" style="gap: 0.5rem">
              <a class="btn btn-outline-primary btn-sm" href="/contato/exportar">Exportar CSV</a>
              <a class="btn btn-outline-primary btn-sm" href="/contato/exportar?formato=json">JSON</a>
              <a class="btn btn-primary" href="/contato/index">Novo contato</a>
            </div>
          </div>

          <form method="get" action="/" class="filtro-bar" role="search">
            <label class="sr-only" for="busca">Buscar contatos</label>
            <input id="busca" type="search" name="q" value="<%= filtros.busca %>"
                   class="form-control filtro-busca" maxlength="120"
                   placeholder="Buscar por nome, e-mail ou telefone">
            <% if (filtros.etiqueta) { %>
              <input type="hidden" name="etiqueta" value="<%= filtros.etiqueta %>">
            <% } %>
            <div class="form-check filtro-check">
              <input class="form-check-input" type="checkbox" id="favoritos" name="favoritos"
                     value="1" <%= filtros.favoritos ? 'checked' : '' %>>
              <label class="form-check-label" for="favoritos">Somente favoritos</label>
            </div>
            <button type="submit" class="btn btn-outline-primary">Filtrar</button>
            <% if (filtros.ativos) { %>
              <a class="btn btn-link" href="/">Limpar</a>
            <% } %>
          </form>

          <% if (filtros.etiqueta) { %>
            <p class="subtitle mb-2">
              Filtrando pela etiqueta
              <span class="badge badge-etiqueta"><%= filtros.etiqueta %></span>
            </p>
          <% } %>

          <% if (contatos.length === 0) { %>
            <div class="empty-state">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <h2 class="h4">Nenhum contato encontrado.</h2>
              <p class="lead">Ajuste a busca ou os filtros e tente novamente.</p>
              <p class="mt-2"><a class="btn btn-link" href="/">Limpar filtros</a></p>
            </div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table my-3">
              <caption class="sr-only">Lista de contatos cadastrados</caption>
              <thead>
                <tr>
                  <th scope="col" class="col-estrela"><span class="sr-only">Favorito</span></th>
                  <th scope="col">Nome</th>
                  <th scope="col">Sobrenome</th>
                  <th scope="col">Telefone</th>
                  <th scope="col">E-mail</th>
                  <th scope="col" class="text-right"><span class="sr-only">Ações</span></th>
                </tr>
              </thead>
              <tbody>
                <% contatos.forEach((contato) => { %>
                  <tr>
                    <td class="col-estrela">
                      <!-- Favorito é mutação de estado: POST + CSRF, nunca GET. -->
                      <form action="/contato/favorito/<%= contato.id %>" method="post" class="d-inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-estrela <%= contato.favorito ? 'ativo' : '' %>"
                          aria-label="<%= contato.favorito ? 'Remover dos favoritos' : 'Marcar como favorito' %>"
                          aria-pressed="<%= contato.favorito ? 'true' : 'false' %>">
                          <svg viewBox="0 0 24 24" fill="<%= contato.favorito ? 'currentColor' : 'none' %>"
                            stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                            stroke-linejoin="round" aria-hidden="true">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                          </svg>
                        </button>
                      </form>
                    </td>
                    <td>
                      <%= contato.nome %>
                      <% if (contato.etiquetas && contato.etiquetas.length > 0) { %>
                        <span class="d-block mt-1">
                          <% contato.etiquetas.forEach((etiqueta) => { %>
                            <a class="badge badge-etiqueta"
                               href="/?etiqueta=<%= encodeURIComponent(etiqueta) %>"><%= etiqueta %></a>
                          <% }); %>
                        </span>
                      <% } %>
                    </td>
                    <td><%= contato.sobrenome %></td>
                    <td><%= contato.telefone %></td>
                    <td><%= contato.email %></td>
                    <td class="text-nowrap text-right">
                      <a href="/contato/index/<%= contato.id %>">Editar</a>
                      <!-- Exclusão via POST + CSRF. Como GET, um simples prefetch
                           do navegador ou uma <img> em site de terceiros apagava o registro.
                           A confirmação vive em app.js: a CSP bloqueia onclick inline. -->
                      <form action="/contato/delete/<%= contato.id %>" method="post" class="d-inline"
                        data-confirmar="Excluir este contato?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-link text-danger p-0 ml-3">Excluir</button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <% if (paginacao && paginacao.totalPages > 1) { %>
            <nav aria-label="Paginação de contatos">
              <ul class="pagination justify-content-center mb-0">
                <li class="page-item <%= paginacao.page <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="/?page=<%= paginacao.page - 1 %><%= sufixoDeQuery %>">Anterior</a>
                </li>
                <li class="page-item disabled">
                  <span class="page-link">Página <%= paginacao.page %> de <%= paginacao.totalPages %></span>
                </li>
                <li class="page-item <%= paginacao.page >= paginacao.totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="/?page=<%= paginacao.page + 1 %><%= sufixoDeQuery %>">Próxima</a>
                </li>
              </ul>
            </nav>
          <% } %>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('includes/footer'); %>
