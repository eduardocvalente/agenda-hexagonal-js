<%- include('includes/head'); %>
<%- include('includes/nav'); %>

<main class="container" id="conteudo">
  <div class="row justify-content-center">
    <div class="col-lg-7 my-4">
      <%- include('includes/messages') %>

      <div class="app-card">
      <div class="page-head">
        <h1><%= contato.id ? 'Editar contato' : 'Novo contato' %></h1>
        <p class="subtitle mb-0">Preencha os dados abaixo. Campos com * são obrigatórios.</p>
      </div>

      <form action="<%= contato.id ? '/contato/edit/' + contato.id : '/contato/register' %>" method="post" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label for="nome">Nome <span aria-hidden="true">*</span></label>
          <input id="nome" value="<%= contato.nome || '' %>" type="text" class="form-control"
                 name="nome" required maxlength="120" autocomplete="given-name"
                 data-mascara="nome">
        </div>

        <div class="form-group">
          <label for="sobrenome">Sobrenome</label>
          <input id="sobrenome" value="<%= contato.sobrenome || '' %>" type="text" class="form-control"
                 name="sobrenome" maxlength="120" autocomplete="family-name"
                 data-mascara="nome">
        </div>

        <div class="form-group">
          <label for="email">E-mail</label>
          <input id="email" value="<%= contato.email || '' %>" type="email" class="form-control"
                 name="email" maxlength="254" autocomplete="email"
                 aria-describedby="contato-ajuda">
        </div>

        <div class="form-group">
          <label for="telefone">Telefone/WhatsApp</label>
          <input id="telefone" value="<%= contato.telefone || '' %>" type="tel" class="form-control"
                 name="telefone" maxlength="30" autocomplete="tel"
                 data-mascara="telefone" placeholder="(62) 98195-2093"
                 aria-describedby="contato-ajuda">
        </div>

        <div class="form-group">
          <label for="etiquetas">Etiquetas</label>
          <input id="etiquetas" value="<%= contato.etiquetasTexto || '' %>" type="text" class="form-control"
                 name="etiquetas" maxlength="340" autocomplete="off"
                 data-seletor-de-etiquetas
                 aria-describedby="etiquetas-ajuda">
          <small id="etiquetas-ajuda" class="form-text text-muted">
            Digite e pressione Enter para criar uma etiqueta nova. Até 10 por contato.
          </small>
          <% if ((etiquetasDisponiveis || []).length > 0) { %>
            <!-- Sugestões SEMPRE visíveis, sem popup nativo: um clique adiciona. -->
            <div class="sugestoes-etiquetas" data-sugestoes-de-etiquetas>
              <span class="sugestoes-titulo">Já usadas:</span>
              <% etiquetasDisponiveis.forEach((etiqueta) => { %>
                <button type="button" class="badge badge-etiqueta sugestao"
                  data-sugestao-etiqueta="<%= etiqueta %>"><%= etiqueta %></button>
              <% }); %>
            </div>
          <% } %>
        </div>

        <p id="contato-ajuda" class="form-text text-muted">
          Informe ao menos um e-mail ou um telefone.
        </p>

        <button type="submit" class="btn btn-primary">Salvar</button>
        <a class="btn btn-link" href="/">Cancelar</a>
      </form>
      </div>
    </div>
  </div>
</main>

<%- include('includes/footer'); %>
