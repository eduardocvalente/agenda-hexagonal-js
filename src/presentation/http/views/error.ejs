<%- include('includes/head'); %>
<%- include('includes/nav'); %>

<main class="container" id="conteudo">
  <div class="row justify-content-center">
    <div class="col-lg-7 my-5">
      <div class="app-card text-center">
        <h1 class="display-1"><%= status %></h1>
        <p class="lead"><%= message %></p>
        <p class="mt-3"><a class="btn btn-primary" href="/">Voltar para a agenda</a></p>
        <% if (requestId) { %>
          <p class="text-muted small mb-0">Referência para suporte: <code><%= requestId %></code></p>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('includes/footer'); %>
