<%- include('includes/head'); %>
<%- include('includes/nav'); %>

<main class="container" id="conteudo">
  <div class="row justify-content-center">
    <div class="col-lg-10 my-4">
      <%- include('includes/messages') %>

      <div class="app-card">
        <div class="page-head d-flex justify-content-between align-items-center flex-wrap">
          <div>
            <h1 class="mb-1">Calendário</h1>
            <p class="subtitle mb-0">
              <%= tituloDoMes %> — <%= totalNoMes %> compromisso<%= totalNoMes === 1 ? '' : 's' %>.
            </p>
          </div>
          <div class="d-flex align-items-center" style="gap: 0.5rem">
            <a class="btn btn-outline-primary btn-sm" href="/calendario?mes=<%= mesAnterior %>"
               aria-label="Mês anterior">&larr; Anterior</a>
            <a class="btn btn-outline-primary btn-sm" href="/calendario">Hoje</a>
            <a class="btn btn-outline-primary btn-sm" href="/calendario?mes=<%= mesSeguinte %>"
               aria-label="Próximo mês">Próximo &rarr;</a>
            <a class="btn btn-primary" href="/compromisso/index">Novo compromisso</a>
          </div>
        </div>

        <div class="table-responsive">
          <table class="calendario" aria-label="Calendário de <%= tituloDoMes %>">
            <thead>
              <tr>
                <% diasDaSemana.forEach((dia) => { %>
                  <th scope="col"><%= dia %></th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% semanas.forEach((semana) => { %>
                <tr>
                  <% semana.forEach((celula) => { %>
                    <% if (!celula) { %>
                      <td class="celula-vazia" aria-hidden="true"></td>
                    <% } else { %>
                      <td class="<%= celula.hoje ? 'celula-hoje' : '' %>">
                        <span class="celula-dia"><%= celula.dia %></span>
                        <% celula.compromissos.forEach((compromisso) => { %>
                          <a class="celula-evento" href="/compromisso/index/<%= compromisso.id %>"
                             title="<%= compromisso.titulo %> às <%= compromisso.horaFormatada %>">
                            <span class="celula-evento-hora"><%= compromisso.horaFormatada %></span>
                            <%= compromisso.titulo %>
                          </a>
                        <% }); %>
                      </td>
                    <% } %>
                  <% }); %>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="app-card mt-4">
        <h2 class="h5">Próximos compromissos</h2>
        <% if (proximos.length === 0) { %>
          <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <h3 class="h5">Nenhum compromisso agendado.</h3>
            <p class="lead">Registre o primeiro para vê-lo aqui e no calendário.</p>
            <p class="mt-2"><a class="btn btn-primary" href="/compromisso/index">Novo compromisso</a></p>
          </div>
        <% } else { %>
          <ul class="lista-simples mt-2">
            <% proximos.forEach((compromisso) => { %>
              <li>
                <span>
                  <a href="/compromisso/index/<%= compromisso.id %>"><%= compromisso.titulo %></a>
                  <% if (compromisso.notas) { %>
                    <span class="text-muted small d-block"><%= compromisso.notas %></span>
                  <% } %>
                </span>
                <time class="text-muted small" datetime="<%= compromisso.inicioEm.toISOString() %>">
                  <%= compromisso.inicioFormatado %>
                </time>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('includes/footer'); %>
