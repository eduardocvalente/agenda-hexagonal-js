{
  "name": "agenda-hexagonal",
  "version": "1.0.0",
  "description": "Agenda de contatos e compromissos em arquitetura Hexagonal — Node.js, Express, MongoDB e EJS, com trilha de auditoria e 172 testes.",
  "author": "Eduardo Valente (https://eduardovalente.dev)",
  "homepage": "https://agenda.eduardovalente.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardocvalente/agenda-hexagonal.git"
  },
  "main": "server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js --ignore public --ignore tests",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,yml}\"",
    "audit:deps": "npm audit --audit-level=high",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "express",
    "mongodb",
    "ejs",
    "portfolio"
  ],
  "author": "Eduardo Valente",
  "license": "LicenseRef-Proprietary",
  "private": true,
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^7.8.3",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "ejs": "^3.1.10"
  }
}
