# Copie para .env e preencha. NUNCA versione o .env.
# A aplicação valida estas variáveis no boot e falha imediatamente se algo
# estiver ausente ou fraco (src/config/env.js) — errar aqui derruba o deploy,
# não a produção às 3h da manhã.

# development | test | staging | production
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Banco de dados (obrigatório) ---
# Local:  mongodb://app:app@localhost:27017/cadastro_usuario?authSource=admin
# Atlas:  mongodb+srv://<user>:<senha>@<cluster>.mongodb.net/cadastro_usuario?retryWrites=true&w=majority
MONGODB_URI=mongodb://app:app@localhost:27017/cadastro_usuario?authSource=admin
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=0

# --- Sessão (obrigatório) ---
# Gere com: openssl rand -hex 32
# Mínimo de 32 caracteres. Trocar este valor invalida todas as sessões ativas.
SESSION_SECRET=
SESSION_COOKIE_NAME=sid
SESSION_MAX_AGE_MS=43200000
# true obrigatoriamente em produção (exige HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Segurança ---
# Custo do bcrypt. 12 é o piso recomendado hoje; 4 apenas em testes.
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# Número de proxies confiáveis à frente da aplicação (ALB = 1). 0 sem proxy.
TRUST_PROXY_HOPS=0

# --- Auditoria ---
# Retenção da trilha de atividades, em dias. Um índice TTL apaga os registros
# vencidos automaticamente. Guardar dado pessoal além da finalidade é irregular
# pela LGPD, e esta é a collection que mais cresce no sistema.
AUDITORIA_RETENCAO_DIAS=180

# --- Operação ---
SHUTDOWN_TIMEOUT_MS=10000
APP_VERSION=dev

# --- Seed (opcional, apenas para "npm run seed") ---
# Cria a conta inicial de forma idempotente: rodar duas vezes não duplica.
# A senha passa pela mesma política do cadastro (mínimo 12 caracteres).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# SEED_DEMO=1 também cria contatos de exemplo na conta.
# SEED_DEMO=0
